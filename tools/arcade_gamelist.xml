        <!-- Arcade gamelist for the 1080x1920 portrait mirror. Everything is placed in screen fractions. -->
        <view name="gamelist">
            <image name="background">
                <color>07060F</color>
            </image>
            <image name="band1, band2, band3, band4">
                <visible>false</visible>
            </image>
            <!-- the current game's own gameplay shot, blurred and dimmed, tints the whole screen -->
            <image name="ambience">
                <pos>0.5 0.3</pos>
                <origin>0.5 0.5</origin>
                <size>1.5 0.9</size>
                <imageType>screenshot,titlescreen,cover</imageType>
                <interpolation>linear</interpolation>
                <brightness>-0.5</brightness>
                <saturation>1.3</saturation>
                <scrollFadeIn>true</scrollFadeIn>
                <zIndex>2</zIndex>
            </image>
            <image name="fadeTop">
                <path>./core/images/band.png</path>
                <pos>0 0</pos>
                <size>1 0.5</size>
                <color>07060F00</color>
                <colorEnd>07060FFF</colorEnd>
                <gradientType>vertical</gradientType>
                <zIndex>3</zIndex>
            </image>
            <image name="fadeBottom">
                <path>./core/images/band.png</path>
                <pos>0 0.4</pos>
                <size>1 0.6</size>
                <color>07060FE0</color>
                <colorEnd>07060FFF</colorEnd>
                <gradientType>vertical</gradientType>
                <zIndex>3</zIndex>
            </image>

            <!-- marquee -->
            <text name="marquee">
                <pos>0.5 0.045</pos>
                <origin>0.5 0</origin>
                <size>1 0.06</size>
                <text>${marqueeText}</text>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.05</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>29F0FF</color>
                <lineSpacing>1.0</lineSpacing>
                <zIndex>20</zIndex>
            </text>
            <image name="marqueeRule">
                <path>./core/images/band.png</path>
                <pos>0.5 0.106</pos>
                <origin>0.5 0</origin>
                <size>0.86 0.0035</size>
                <color>FF2D95</color>
                <colorEnd>FFC400</colorEnd>
                <gradientType>horizontal</gradientType>
                <zIndex>20</zIndex>
            </image>
            <text name="customCollectionsSystemName, collectionsSystemName, customCollectionsHeaderNoMedia">
                <visible>false</visible>
            </text>
            <text name="customCollectionsHeader">
                <pos>0.5 0.114</pos>
                <origin>0.5 0</origin>
                <size>0.9 0.022</size>
                <horizontalAlignment>center</horizontalAlignment>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.019</fontSize>
                <color>FFC400</color>
                <letterCase>uppercase</letterCase>
                <zIndex>20</zIndex>
            </text>
            <gamelistinfo name="gamelistInfo">
                <pos>0.5 0.114</pos>
                <origin>0.5 0</origin>
                <size>0.9 0.022</size>
                <horizontalAlignment>center</horizontalAlignment>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.019</fontSize>
                <color>B9B4DA</color>
                <zIndex>20</zIndex>
            </gamelistinfo>
            <image name="consolegame, logo, backframe2, backframe3">
                <visible>false</visible>
            </image>

            <!-- CRT: gameplay shot -->
            <image name="crtGlow">
                <path>./core/images/band.png</path>
                <pos>0.5 0.282</pos>
                <origin>0.5 0.5</origin>
                <size>0.78 0.274</size>
                <color>29F0FF55</color>
                <cornerRadius>0.04</cornerRadius>
                <zIndex>8</zIndex>
            </image>
            <image name="crtBezel">
                <path>./core/images/band.png</path>
                <pos>0.5 0.282</pos>
                <origin>0.5 0.5</origin>
                <size>0.755 0.262</size>
                <color>000000</color>
                <cornerRadius>0.035</cornerRadius>
                <zIndex>9</zIndex>
            </image>
            <image name="gameImage">
                <pos>0.5 0.282</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.72 0.245</maxSize>
                <imageType>screenshot,titlescreen,cover</imageType>
                <interpolation>nearest</interpolation>
                <cornerRadius>0.02</cornerRadius>
                <scrollFadeIn>true</scrollFadeIn>
                <zIndex>10</zIndex>
            </image>
            <!-- cabinet cards tilted over the CRT corners -->
            <image name="gameCover">
                <pos>0.2 0.395</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.30 0.18</maxSize>
                <imageType>cover</imageType>
                <rotation>-6</rotation>
                <cornerRadius>0.008</cornerRadius>
                <scrollFadeIn>true</scrollFadeIn>
                <zIndex>15</zIndex>
            </image>
            <image name="gameTitle">
                <pos>0.81 0.405</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.30 0.11</maxSize>
                <imageType>titlescreen</imageType>
                <interpolation>nearest</interpolation>
                <rotation>5</rotation>
                <cornerRadius>0.008</cornerRadius>
                <scrollFadeIn>true</scrollFadeIn>
                <zIndex>15</zIndex>
            </image>

            <!-- title, stars, facts -->
            <text name="gameName">
                <pos>0.5 0.488</pos>
                <origin>0.5 0</origin>
                <size>0.94 0.042</size>
                <metadata>name</metadata>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.038</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>FFFFFF</color>
                <letterCase>uppercase</letterCase>
                <zIndex>20</zIndex>
            </text>
            <rating name="rating">
                <pos>0.5 0.533</pos>
                <origin>0.5 0</origin>
                <size>0 0.024</size>
                <interpolation>nearest</interpolation>
                <color>FFC400</color>
                <filledPath>./core/images/rating_filled.svg</filledPath>
                <unfilledPath>./core/images/rating_empty.svg</unfilledPath>
                <overlay>false</overlay>
                <zIndex>20</zIndex>
            </rating>
            <text name="labelReleasedate, labelPlayers, labelGenre, labelDeveloper, labelPublisher">
                <size>0.30 0.016</size>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.0135</fontSize>
                <color>29F0FF</color>
                <letterCase>uppercase</letterCase>
                <zIndex>20</zIndex>
            </text>
            <text name="players, genre, developer, publisher">
                <size>0.30 0.022</size>
                <fontPath>${semiBoldFont}</fontPath>
                <fontSize>0.0185</fontSize>
                <color>FFFFFF</color>
                <letterCase>uppercase</letterCase>
                <zIndex>20</zIndex>
            </text>
            <datetime name="releasedate">
                <size>0.30 0.022</size>
                <fontPath>${semiBoldFont}</fontPath>
                <fontSize>0.0185</fontSize>
                <color>FFFFFF</color>
                <format>%Y</format>
                <zIndex>20</zIndex>
            </datetime>
            <text name="labelReleasedate"><pos>0.05 0.566</pos><text>YEAR</text><metadataElement>true</metadataElement></text>
            <datetime name="releasedate"><pos>0.05 0.5805</pos><metadata>releasedate</metadata></datetime>
            <text name="labelPlayers"><pos>0.28 0.566</pos><text>PLAYERS</text><metadataElement>true</metadataElement></text>
            <text name="players"><pos>0.28 0.5805</pos><metadata>players</metadata></text>
            <text name="labelGenre"><pos>0.51 0.566</pos><text>GENRE</text><metadataElement>true</metadataElement></text>
            <text name="genre"><pos>0.51 0.5805</pos><metadata>genre</metadata></text>
            <text name="labelDeveloper"><pos>0.05 0.601</pos><text>DEVELOPER</text><metadataElement>true</metadataElement></text>
            <text name="developer"><pos>0.05 0.6155</pos><metadata>developer</metadata></text>
            <text name="labelPublisher"><pos>0.51 0.601</pos><text>PUBLISHER</text><metadataElement>true</metadataElement></text>
            <text name="publisher"><pos>0.51 0.6155</pos><metadata>publisher</metadata></text>
            <text name="labelLastplayed, labelPlaytime">
                <visible>false</visible>
            </text>
            <datetime name="lastplayed">
                <visible>false</visible>
            </datetime>
            <text name="playtime">
                <visible>false</visible>
            </text>
            <text name="description">
                <pos>0.05 0.642</pos>
                <size>0.90 0.078</size>
                <container>true</container>
                <containerVerticalSnap>true</containerVerticalSnap>
                <containerScrollSpeed>1</containerScrollSpeed>
                <containerStartDelay>3</containerStartDelay>
                <containerResetDelay>5</containerResetDelay>
                <metadata>description</metadata>
                <fontPath>${regularFont}</fontPath>
                <fontSize>0.0215</fontSize>
                <lineSpacing>1.1</lineSpacing>
                <color>D9D5F2</color>
                <letterCase>none</letterCase>
                <zIndex>20</zIndex>
            </text>
            <badges name="badges">
                <pos>0.95 0.566</pos>
                <origin>1 0</origin>
                <size>0.12 0.05</size>
                <slots>favorite, completed, kidgame</slots>
                <horizontalAlignment>right</horizontalAlignment>
                <direction>row</direction>
                <zIndex>20</zIndex>
            </badges>

            <!-- list -->
            <image name="listPanel">
                <path>./core/images/band.png</path>
                <pos>0.03 0.73</pos>
                <size>0.94 0.225</size>
                <color>000000B8</color>
                <cornerRadius>0.012</cornerRadius>
                <zIndex>9</zIndex>
            </image>
            <textlist name="gamelistTextlist">
                <pos>0.04 0.737</pos>
                <size>0.92 0.21</size>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.03</fontSize>
                <selectorColor>FF2D95</selectorColor>
                <selectorColorEnd>FF7A3D</selectorColorEnd>
                <selectorGradientType>horizontal</selectorGradientType>
                <selectedColor>FFFFFF</selectedColor>
                <primaryColor>D9D5F2</primaryColor>
                <secondaryColor>6E6A8C</secondaryColor>
                <horizontalAlignment>left</horizontalAlignment>
                <horizontalMargin>0.012</horizontalMargin>
                <letterCase>uppercase</letterCase>
                <indicators>symbols</indicators>
                <collectionIndicators>symbols</collectionIndicators>
                <zIndex>20</zIndex>
            </textlist>
            <helpsystem name="help">
                <textColor>B9B4DA</textColor>
                <iconColor>29F0FF</iconColor>
                <textColorDimmed>77739A</textColorDimmed>
                <iconColorDimmed>77739A</iconColorDimmed>
            </helpsystem>
        </view>
