# Install (once), from the project folder (it is assumed to live in ~/mirror-dashboard; edit the path below if it does not):
#   mkdir -p ~/.config/systemd/user && cp tools/mirror-mdns.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now mirror-mdns.service
[Unit]
Description=Mirror: publish party.local on the local network
After=network-online.target avahi-daemon.service

[Service]
ExecStart=/usr/bin/python3 %h/mirror-dashboard/tools/mdns_alias.py party.local
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
